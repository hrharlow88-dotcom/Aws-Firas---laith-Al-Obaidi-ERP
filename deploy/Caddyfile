{
	email {$ACME_EMAIL}
}

# The application, over HTTPS with an automatic certificate.
# For a server reached only inside the company network, put its IP or a local
# name in ERP_DOMAIN and replace this block's first line with  http://{$ERP_DOMAIN}
{$ERP_DOMAIN} {
	encode zstd gzip
	# Browsers that saw the site once always come back over HTTPS (set after the
	# proxied response, so it replaces the API's own copy instead of doubling it).
	header {
		Strict-Transport-Security "max-age=31536000"
		defer
	}
	reverse_proxy web:80
}

# Earlier addresses of the system (bookmarks, installed apps, old links) forward
# to the main domain. 308 keeps the method, so integrations posting to an old
# address keep working. Set ERP_OLD_DOMAINS in .env, e.g. srv123.hstgr.cloud
{$ERP_OLD_DOMAINS} {
	redir https://{$ERP_DOMAIN}{uri} 308
}

# Fingerprint devices (ZKTeco ADMS) usually cannot do HTTPS. They get a
# separate plain-HTTP port that only reaches the device endpoint; allow it in
# the firewall for the branch networks only.
:8081 {
	@devices path /iclock/*
	handle @devices {
		reverse_proxy web:80
	}
	handle {
		respond 404
	}
}

# Other companies running their own copy of the system on this server (deploy/new-company.sh).
import companies/*.caddy
