# Wrap any value containing # or spaces in double quotes: an unquoted # starts
# a comment, so Pass#2026 would silently become Pass.
DB_NAME=laith_erp
DB_USER=laith_erp_app
DB_PASSWORD=replace-with-a-long-random-database-password
DB_SSL=false
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_NAME=مسؤول النظام
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
WEB_PORT=3000
# 32 random bytes, base64 (openssl rand -base64 32). Back it up off the server:
# without it, stored national ID and bank account numbers cannot be read.
DATA_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
TRUST_PROXY_HOPS=1
# SAP Business One Service Layer (optional)
SAP_B1_URL=
SAP_B1_COMPANY_DB=
SAP_B1_USER=
SAP_B1_PASSWORD=
SAP_B1_LOCAL_CURRENCY=IQD
# Performance portal (job descriptions, KPIs and evaluations)
PERFORMANCE_PORTAL_URL=https://alobaidi-hr.github.io
