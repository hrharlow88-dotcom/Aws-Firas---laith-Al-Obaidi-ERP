# Wrap any value containing # or spaces in double quotes: an unquoted # starts
# a comment, so Pass#2026 would silently become Pass.
DB_NAME=laith_erp
DB_USER=laith_erp_app
DB_PASSWORD=replace-with-a-long-random-database-password
DB_SSL=false
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_NAME=مسؤول النظام
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
WEB_PORT=3000
